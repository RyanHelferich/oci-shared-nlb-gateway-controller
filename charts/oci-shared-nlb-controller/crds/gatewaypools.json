{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": {
    "name": "gatewaypools.nlb.independent.dev"
  },
  "spec": {
    "group": "nlb.independent.dev",
    "scope": "Namespaced",
    "names": {
      "kind": "GatewayPool",
      "listKind": "GatewayPoolList",
      "plural": "gatewaypools",
      "singular": "gatewaypool"
    },
    "versions": [
      {
        "name": "v1alpha1",
        "served": true,
        "storage": true,
        "schema": {
          "openAPIV3Schema": {
            "type": "object",
            "properties": {
              "apiVersion": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "metadata": {
                "type": "object"
              },
              "spec": {
                "type": "object",
                "properties": {
                  "gatewayClassName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "occupancy": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50,
                    "default": 45
                  },
                  "maxGateways": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 27
                  },
                  "portStart": {
                    "type": "integer",
                    "minimum": 1024,
                    "maximum": 65535,
                    "default": 20000
                  },
                  "maxWorkers": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 512
                  }
                },
                "required": [
                  "gatewayClassName",
                  "occupancy",
                  "maxGateways",
                  "portStart"
                ],
                "x-kubernetes-validations": [
                  {
                    "rule": "self.gatewayClassName == oldSelf.gatewayClassName",
                    "message": "gatewayClassName is immutable; create a new resource for migration"
                  },
                  {
                    "rule": "self.occupancy == oldSelf.occupancy",
                    "message": "occupancy is immutable; create a new resource for migration"
                  },
                  {
                    "rule": "self.maxGateways == oldSelf.maxGateways",
                    "message": "maxGateways is immutable; create a new resource for migration"
                  },
                  {
                    "rule": "self.portStart == oldSelf.portStart",
                    "message": "portStart is immutable; create a new resource for migration"
                  },
                  {
                    "rule": "has(self.maxWorkers) == has(oldSelf.maxWorkers) && (!has(self.maxWorkers) || self.maxWorkers == oldSelf.maxWorkers)",
                    "message": "maxWorkers is immutable; create a new resource for migration"
                  },
                  {
                    "rule": "self.portStart + self.occupancy - 1 <= 65535",
                    "message": "Listener port range must fit within 65535"
                  },
                  {
                    "rule": "self.occupancy * (has(self.maxWorkers) ? self.maxWorkers : 20) <= 1024",
                    "message": "occupancy times maxWorkers (default 20, including surge) must fit 1024 backends"
                  }
                ]
              },
              "status": {
                "type": "object",
                "x-kubernetes-preserve-unknown-fields": true
              }
            },
            "required": [
              "spec"
            ]
          }
        },
        "subresources": {
          "status": {}
        },
        "additionalPrinterColumns": [
          {
            "name": "Per-NLB",
            "type": "integer",
            "jsonPath": ".spec.occupancy"
          },
          {
            "name": "Max-NLBs",
            "type": "integer",
            "jsonPath": ".spec.maxGateways"
          },
          {
            "name": "Used-Slots",
            "type": "integer",
            "jsonPath": ".status.used"
          },
          {
            "name": "Free-Slots",
            "type": "integer",
            "jsonPath": ".status.available"
          },
          {
            "name": "Age",
            "type": "date",
            "jsonPath": ".metadata.creationTimestamp"
          }
        ]
      }
    ]
  }
}
